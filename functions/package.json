{
  "name": "musq-functions",
  "description": "MUSQ's server: the AI coach chat, photo meal logging and the goal photo, for Premium members. Holds the OpenAI key.",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"lib/test/**/*.test.js\"",
    "emulators": "tsc && MOCK_OPENAI=1 firebase emulators:start --only auth,functions,firestore"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "openai": "^7.62.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
