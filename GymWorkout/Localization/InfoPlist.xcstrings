    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MUSQ uses the camera when you photograph a meal to log it, take a photo of yourself for your goal photo, or snap a photo to share with your friends."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ dùng camera khi bạn chụp ảnh bữa ăn để ghi lại, chụp ảnh chính bạn để làm ảnh mục tiêu, hoặc chụp ảnh check-in để đăng cho bạn bè."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MUSQ reads your steps, walking distance, active energy, sleep and workouts from Apple Health to show your day and fit your calorie plan to how much you move. It stays on this device and is never sent to advertisers; your sleep goes to the AI coach (through MUSQ's server to OpenAI) only if you include it in a question."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ đọc số bước, quãng đường đi bộ, năng lượng hoạt động, giấc ngủ và các buổi tập từ Apple Health để hiện tổng quan trong ngày và điều chỉnh kế hoạch calo theo mức vận động của bạn. Dữ liệu chỉ ở trên thiết bị này và không bao giờ được gửi cho nhà quảng cáo; dữ liệu giấc ngủ chỉ được gửi đến huấn luyện viên AI (qua máy chủ của MUSQ đến OpenAI) nếu bạn đưa nó vào một câu hỏi."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MUSQ only reads from Apple Health (steps, sleep, active energy and workouts) and never saves anything to it."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ chỉ đọc từ Apple Health (số bước, giấc ngủ, năng lượng hoạt động và các buổi tập) và không bao giờ ghi gì vào đó."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MUSQ listens only while the mic is on, to log water, a walk or a meal by voice. The words are recognised on your device and the audio is never saved or sent."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ chỉ nghe khi micrô đang bật, để ghi nước, đi bộ hoặc bữa ăn bằng giọng nói. Lời nói được nhận dạng ngay trên thiết bị của bạn, âm thanh không bao giờ được lưu hay gửi đi."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MUSQ saves your goal photo to your library when you ask it to."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ lưu ảnh mục tiêu vào Ảnh khi bạn yêu cầu."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MUSQ turns what you say into text on your device, for a water, walk or meal log or a meal scan's note. The audio is never saved or sent; a meal scan's note goes with the scan when you tap Read this meal."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ chuyển lời bạn nói thành chữ ngay trên thiết bị, để ghi nước, đi bộ, bữa ăn hoặc ghi chú khi quét bữa ăn. Âm thanh không bao giờ được lưu hay gửi đi; ghi chú chỉ được gửi kèm lượt quét khi bạn chạm Nhận diện bữa ăn này."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your data is used to show ads that are more relevant to you. Saying no doesn't change anything else in MUSQ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu của bạn được dùng để hiện quảng cáo phù hợp hơn với bạn. Từ chối cũng không thay đổi gì khác trong MUSQ."
          }
        }
      }
    }
  },
  "version" : "1.0"
}