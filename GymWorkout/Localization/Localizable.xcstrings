          }
        }
      }
    },
    "That's today's %lld questions. Pro gives you %lld a day, or ask again tomorrow." : {
      "comment" : "The coach's daily limit on Premium: That's today's 10 questions. Pro gives you 30 a day…",
      "localizations" : {
        "en" : {
          "stringUnit" : {
