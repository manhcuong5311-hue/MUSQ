      }
    },
    "Payment is charged to your Apple Account when you confirm." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản thanh toán sẽ được tính vào Tài khoản Apple của bạn khi bạn xác nhận."
          }
        }
      }
    },
    "Payments are handled by Apple. Request a refund at reportaproblem.apple.com, signed in with the Apple Account you paid with." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc thanh toán do Apple xử lý. Hãy yêu cầu hoàn tiền tại reportaproblem.apple.com, đăng nhập bằng Tài khoản Apple bạn đã dùng để thanh toán."
          }
        }
      }
    },
    "per month" : {
