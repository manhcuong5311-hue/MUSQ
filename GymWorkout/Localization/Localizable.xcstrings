      }
    },
    "once" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "một lần"
          }
        }
      }
    },
    "Once every group in your split has been trained, a new round starts and each turns green again as it recovers." : {
      "localizations" : {
