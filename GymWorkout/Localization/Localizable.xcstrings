          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã hết ảnh mục tiêu năm nay của gói Premium. Pro tạo được tối đa %lld ảnh mỗi năm."
          }
        }
      }
    },
    "That's this year's goal photos. More next year." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
