          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ không thể lưu vào Ảnh"
          }
        }
      }
    },
    "MUSQ couldn't edit the photo right now. Check your connection and try again." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MUSQ hiện chưa chỉnh sửa được ảnh. Kiểm tra kết nối và thử lại."
          }
        }
      }
    },
    "MUSQ couldn't find a walk in that. Try “30 minutes” or “4,000 steps”." : {
      "comment" : "Quick log Walk tab: the words held no walk. The quoted words are examples to say or type; the app reads them in Vietnamese too",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "vi" : {
          "stringUnit" : {
