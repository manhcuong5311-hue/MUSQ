    },
    "Yes" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có"
          }
        }
      }
    },
    "Yes, for a walk without your phone or Watch: in a quick log on Today, add it under Walk, in minutes or steps (a minute counts as about 100 steps). It's kept in MUSQ with your other logs and never written to Apple Health. It counts with your steps on Today and in Progress, and in the step average for your calorie plan when your steps set it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có, cho những lần đi bộ không mang theo điện thoại hay Watch: trong mục ghi nhanh ở tab Hôm nay, thêm lần đi bộ ở tab Đi bộ, theo số phút hoặc số bước (một phút được tính là khoảng 100 bước). Lần đi bộ được lưu trong MUSQ cùng các mục bạn đã ghi khác và không bao giờ được ghi vào Apple Health. Lần đi bộ được cộng vào số bước của bạn ở tab Hôm nay và tab Tiến độ, và vào số bước trung bình cho kế hoạch calo khi kế hoạch dựa theo số bước của bạn."
          }
        }
      }
    },
    "Yes, it stays below 160/100" : {
      "comment" : "Text for a yes/no option in a health question.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có, luôn dưới 160/100"
          }
        }
      }
    },
    "Yes. Tap Edit next to About You in Profile to change your goal, days a week and split. Your workout history stays as it is." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có. Chạm Sửa bên cạnh Về bạn trong mục Cá nhân để đổi mục tiêu, số ngày tập mỗi tuần và lịch chia nhóm cơ. Lịch sử tập luyện của bạn vẫn được giữ nguyên."
          }
        }
      }
    },
    "yesterday" : {
      "comment" : "A day inside a sentence: “Trained yesterday”",
