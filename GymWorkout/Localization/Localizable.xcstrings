      }
    },
    "That's today's %lld questions on Premium. Pro keeps everything in your plan and gives you %lld questions a day." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That's today's %1$lld questions on Premium. Pro keeps everything in your plan and gives you %2$lld questions a day."
