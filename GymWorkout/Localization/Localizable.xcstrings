      }
    },
    "every session trains both the upper and the lower body, so no muscle waits a whole week." : {
      "comment" : "Finishes “<split> suits N days a week best: …”",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "buổi nào cũng tập cả thân trên lẫn thân dưới, nên không nhóm cơ nào phải chờ cả tuần."
          }
        }
      }
    },
    "Every set counts." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiệp nào cũng đáng giá."
          }
        }
      }
    },
    "Every set is %lld reps or more: no maximal efforts." : {
      "comment" : "The rep floor: Every set is 10 reps or more",
      "localizations" : {
